# Zanokuhle Intellectuals Academy — Apache config for cPanel hosting.
#
# Lives in public/ so Vite copies it into dist/ on every build. It was briefly
# maintained by hand in dist/ instead, which is gitignored — so any rebuild
# would have dropped it, taking HTTPS, the 404 page and the redirects below
# with it, silently.
#
# Every route is a real prerendered index.html, so there is deliberately no SPA
# catch-all rewrite: one would mask genuine 404s and serve the homepage for
# mistyped URLs, which is worse for visitors and for crawlers.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let's Encrypt validates by fetching a token over plain HTTP at
  # /.well-known/acme-challenge/. Redirecting that to HTTPS breaks the check
  # before a certificate exists — which is why cPanel reported "HTTP-based
  # Domain Control Validation failed" on the first issue. DNS validation
  # covered it that time; this stops the ~90-day auto-renewal depending on
  # that happening again.
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonicalise on the bare domain. siteConfig.js, sitemap.xml, robots.txt and
  # every canonical tag name the apex, so www must redirect to it or the site
  # answers on two addresses that disagree about which one is real.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ── Legacy WordPress URLs ────────────────────────────────────────────────
  # The old site used flat slugs; programme pages are now nested under
  # /programmes/. Without these, every link to the old site in Google's index,
  # on social media or in someone's bookmarks dead-ends on a 404.
  # 301 (permanent) so search engines transfer the old ranking rather than
  # treating these as two competing pages.
  #
  # RewriteRule, not RedirectMatch. RedirectMatch belongs to mod_alias, and
  # nesting it inside an <IfModule mod_rewrite.c> block makes it depend on a
  # module that does not own it. mod_rewrite is demonstrably active here (the
  # HTTPS redirect above works), so expressing these as rewrites removes a
  # module we were relying on without checking. Note the patterns have no
  # leading slash: in .htaccess context mod_rewrite strips the directory
  # prefix before matching, which is the opposite of RedirectMatch.
  RewriteRule ^alexandra-learner-advancement/?$    /programmes/alexandra-learner-advancement [L,R=301]
  RewriteRule ^early-childhood-development/?$      /programmes/early-childhood-development [L,R=301]
  RewriteRule ^education-after-school/?$           /programmes/education-after-school [L,R=301]
  RewriteRule ^skills-and-youth-development/?$     /programmes/skills-and-youth-development [L,R=301]
  RewriteRule ^social-and-community-development/?$ /programmes/social-and-community-development [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Vite fingerprints these filenames, so a year is safe and anything less is
  # wasted bandwidth.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  # HTML is not fingerprinted: it must revalidate or a deploy goes unseen.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# Cache-Control belongs to mod_headers, not mod_expires. These were previously
# nested inside the mod_expires block above, which meant Apache would only skip
# them if mod_expires were missing — on a server with mod_expires but without
# mod_headers, an unrecognised Header directive in .htaccess is a hard 500 for
# every request, taking the whole site down. Same mistake as putting
# RedirectMatch under an <IfModule mod_rewrite.c> guard: each directive has to
# sit under the module that actually owns it.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
